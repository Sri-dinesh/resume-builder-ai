{
  "compilerOptions": {
    "types": ["vitest/globals"],
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/lib/ai": ["./src/lib/ai/index.ts"],
      "@/lib/billing": ["./src/lib/billing/index.ts"],
      "@/lib/db": ["./src/lib/db/index.ts"],
      "@/lib/resume": ["./src/lib/resume/index.ts"],
      "@/lib/email": ["./src/lib/email/index.ts"],
      "@/components/resume": ["./src/components/resume/index.ts"],
      "@/components/editor": ["./src/components/editor/index.ts"],
      "@/components/shared": ["./src/components/shared/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.js",
    "**/*.mjs",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
