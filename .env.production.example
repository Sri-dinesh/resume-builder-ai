# ============================================================
# SparkCV — Production Environment Variables
# ============================================================

# --- Runtime ---
NODE_ENV=production                         # Required
NEXT_TELEMETRY_DISABLED=1                   # Required
PORT=3000                                   # Required

# --- Database (Neon) ---
POSTGRES_URL=                               # Required — ROTATE EVERY 90 DAYS
POSTGRES_PRISMA_URL=                        # Required — ROTATE EVERY 90 DAYS
POSTGRES_URL_NO_SSL=                        # Required
POSTGRES_URL_NON_POOLING=                   # Required
POSTGRES_USER=                              # Required
POSTGRES_HOST=                              # Required
POSTGRES_PASSWORD=                          # Required — ROTATE EVERY 90 DAYS
POSTGRES_DATABASE=                          # Required

# --- Auth (Clerk) ---
CLERK_SECRET_KEY=                           # Required — ROTATE EVERY 90 DAYS
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=          # Required
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in      # Required
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up      # Required

# --- Storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=                      # Required — ROTATE EVERY 90 DAYS

# --- AI (Google Gemini) ---
GEMINI_API_KEY=                             # Required — ROTATE EVERY 90 DAYS

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=                          # Required — ROTATE EVERY 90 DAYS
STRIPE_WEBHOOK_SECRET=                      # Required — ROTATE EVERY 90 DAYS
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=         # Required
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO_MONTHLY=    # Required
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO_PLUS_MONTHLY= # Required

# --- App ---
NEXT_PUBLIC_BASE_URL=https://sparkcv.com    # Required


# --- Rate Limiting (Future) ---
# UPSTASH_REDIS_REST_URL=                   # Optional
# UPSTASH_REDIS_REST_TOKEN=                 # Optional
